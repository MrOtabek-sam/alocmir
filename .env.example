# Turso database (https://turso.tech) - free plan is enough to start
TURSO_DATABASE_URL=libsql://alocmir-yourname.turso.io
TURSO_AUTH_TOKEN=paste-token-here

# Password for https://yourdomain.com/admin (8+ characters)
ADMIN_PASSWORD=choose-a-strong-password

# Your live domain, no trailing slash (used for SEO canonical links and sitemap)
VITE_SITE_URL=https://www.yourdomain.com

# Added automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX). Built-in admin analytics work without it.
VITE_GA_ID=

# Telegram order notifications (see README). Several chats: 111,222
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
